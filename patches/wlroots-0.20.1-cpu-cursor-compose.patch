+// Some drivers (NVIDIA proprietary) cannot render to, copy into, or even
+// import linear images with their Vulkan implementation, while their KMS
+// cursor planes only accept linear ARGB8888 buffers. When the renderer cannot
+// produce a cursor-plane-compatible buffer, compose the cursor sprite on the
+// CPU into a linear DRM dumb buffer instead of permanently falling back to a
+// software cursor. The sprite is tiny and only re-composed when its image
+// changes, while a software cursor costs a full output recomposition on every
+// pointer motion and disables direct scan-out.
+static struct wlr_allocator *cpu_cursor_allocator = NULL;
+
+static struct wlr_allocator *get_cpu_cursor_allocator(struct wlr_output *output) {
+	static int alloc_drm_fd = -1;
+	static bool create_failed = false;
+
+	if (create_failed) {
+		return NULL;
+	}
+	int drm_fd = wlr_backend_get_drm_fd(output->backend);
+	if (drm_fd < 0) {
+		return NULL;
+	}
+	if (cpu_cursor_allocator != NULL) {
+		return alloc_drm_fd == drm_fd ? cpu_cursor_allocator : NULL;
+	}
+	cpu_cursor_allocator = wlr_drm_dumb_allocator_create(drm_fd);
+	if (cpu_cursor_allocator == NULL) {
+		// Dumb buffers need a primary node; remember the failure so every
+		// cursor update doesn't retry (and log an error) forever.
+		create_failed = true;
+		return NULL;
+	}
+	alloc_drm_fd = drm_fd;
+	return cpu_cursor_allocator;
+}
+
+static bool output_pick_cursor_format_cpu(struct wlr_output *output,
+		struct wlr_drm_format *format) {
+	if (output->impl->get_cursor_formats == NULL) {
+		return false;
+	}
+	const struct wlr_drm_format_set *display_formats =
+		output->impl->get_cursor_formats(output,
+			WLR_BUFFER_CAP_DATA_PTR | WLR_BUFFER_CAP_DMABUF);
+	if (display_formats == NULL) {
+		return false;
+	}
+	const struct wlr_drm_format *fmt =
+		wlr_drm_format_set_get(display_formats, DRM_FORMAT_ARGB8888);
+	if (fmt == NULL) {
+		return false;
+	}
+	if (!wlr_drm_format_has(fmt, DRM_FORMAT_MOD_LINEAR) &&
+			!wlr_drm_format_has(fmt, DRM_FORMAT_MOD_INVALID)) {
+		return false;
+	}
+	return wlr_drm_format_copy(format, fmt);
+}
+
+static bool render_cursor_buffer_cpu(struct wlr_output_cursor *cursor,
+		struct wlr_texture *texture, struct wlr_buffer *buffer,
+		const struct wlr_box *dst_box) {
+	struct wlr_output *output = cursor->output;
+
+	// Keep the CPU path simple: bail out to the software cursor for rotated
+	// outputs or color-managed cursors, which are both rare.
+	if (output->transform != WL_OUTPUT_TRANSFORM_NORMAL ||
+			cursor->transform != WL_OUTPUT_TRANSFORM_NORMAL ||
+			cursor->color_transform != NULL) {
+		return false;
+	}
+	if (dst_box->width <= 0 || dst_box->height <= 0) {
+		return false;
+	}
+
+	void *data;
+	uint32_t drm_format;
+	size_t stride;
+	if (!wlr_buffer_begin_data_ptr_access(buffer,
+			WLR_BUFFER_DATA_PTR_ACCESS_WRITE, &data, &drm_format, &stride)) {
+		return false;
+	}
+	if (drm_format != DRM_FORMAT_ARGB8888) {
+		wlr_buffer_end_data_ptr_access(buffer);
+		return false;
+	}
+
+	int src_width = texture->width;
+	int src_height = texture->height;
+	uint32_t *src = malloc((size_t)src_width * src_height * 4);
+	if (src == NULL) {
+		wlr_buffer_end_data_ptr_access(buffer);
+		return false;
+	}
+	if (!wlr_texture_read_pixels(texture,
+			&(struct wlr_texture_read_pixels_options){
+				.data = src,
+				.format = DRM_FORMAT_ARGB8888,
+				.stride = (uint32_t)src_width * 4,
+			})) {
+		free(src);
+		wlr_buffer_end_data_ptr_access(buffer);
+		return false;
+	}
+
+	struct wlr_fbox src_box = cursor->src_box;
+	if (src_box.width <= 0 || src_box.height <= 0) {
+		src_box = (struct wlr_fbox){
+			.width = src_width,
+			.height = src_height,
+		};
+	}
+
+	for (int y = 0; y < buffer->height; y++) {
+		uint32_t *row = (uint32_t *)((char *)data + (size_t)y * stride);
+		for (int x = 0; x < buffer->width; x++) {
+			uint32_t pixel = 0;
+			if (x < dst_box->width && y < dst_box->height) {
+				int sx = (int)(src_box.x + x * src_box.width / dst_box->width);
+				int sy = (int)(src_box.y + y * src_box.height / dst_box->height);
+				if (sx >= 0 && sx < src_width && sy >= 0 && sy < src_height) {
+					pixel = src[(size_t)sy * src_width + sx];
+				}
+			}
+			row[x] = pixel;
+		}
+	}
+
+	free(src);
+	wlr_buffer_end_data_ptr_access(buffer);
+	return true;
+}
